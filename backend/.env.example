APP_ENV=development
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:4173","http://127.0.0.1:4173","http://127.0.0.1:5500","http://localhost:5500"]
MAX_RESUME_SIZE_BYTES=10485760
STORAGE_ENDPOINT=http://storage:9000
STORAGE_BUCKET=interviewai-private
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
LLM_API_KEY=
LLM_PROVIDER=huggingface
LLM_BASE_URL=
LLM_MODEL=Qwen/Qwen3-8B
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.7
LLM_INPUT_COST_PER_1M=0
LLM_OUTPUT_COST_PER_1M=0
HF_TOKEN=
